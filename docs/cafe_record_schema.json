{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taiwan Cafe Work Finder Cafe Record",
  "description": "Structural interchange schema only. It is not publication authority; the Python source-policy and publication audit are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cafe_id",
    "canonical_name",
    "aliases",
    "branch_name",
    "branch_identity_status",
    "operational_status",
    "city",
    "district",
    "address",
    "coordinates",
    "external_ids",
    "contact",
    "work_attributes",
    "source_links",
    "field_confidence",
    "overall_confidence",
    "last_verified_at",
    "conflicts",
    "notes"
  ],
  "properties": {
    "cafe_id": { "type": "string" },
    "canonical_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "branch_name": { "type": "string" },
    "branch_identity_status": { "enum": ["resolved", "ambiguous", "unknown"] },
    "operational_status": { "enum": ["open", "temporarily_closed", "closed", "conflicted", "unknown"] },
    "city": { "type": "string" },
    "district": { "type": "string" },
    "address": { "type": "string" },
    "coordinates": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        { "type": "null" }
      ]
    },
    "external_ids": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "instagram_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "facebook_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "threads_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "google_maps_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "phone": { "type": "string", "minLength": 1 }
      }
    },
    "work_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlimited_time",
        "outlets",
        "wifi",
        "quietness",
        "seat_comfort",
        "meeting_suitability",
        "solo_work_suitability",
        "study_suitability",
        "online_meeting_suitability",
        "long_stay_suitability",
        "opening_hours",
        "minimum_order",
        "price_level",
        "food_available",
        "reservation"
      ],
      "properties": {
        "unlimited_time": { "enum": ["yes", "no", "limited", "conditional", "unknown"] },
        "outlets": { "enum": ["abundant", "some", "limited", "none", "unknown"] },
        "wifi": { "enum": ["yes", "no", "unknown"] },
        "quietness": { "enum": ["quiet", "moderate", "lively", "noisy", "unknown"] },
        "seat_comfort": { "enum": ["good", "fair", "poor", "unknown"] },
        "meeting_suitability": { "enum": ["high", "medium", "low", "unknown"] },
        "solo_work_suitability": { "enum": ["high", "medium", "low", "unknown"] },
        "study_suitability": { "enum": ["high", "medium", "low", "unknown"] },
        "online_meeting_suitability": { "enum": ["high", "medium", "low", "unknown"] },
        "long_stay_suitability": { "enum": ["high", "medium", "low", "unknown"] },
        "opening_hours": { "type": "string" },
        "minimum_order": { "type": "string" },
        "price_level": { "type": "string" },
        "food_available": { "enum": ["yes", "no", "unknown"] },
        "reservation": { "enum": ["yes", "no", "unknown"] }
      }
    },
    "source_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "url",
          "title",
          "retrieved_at",
          "published_at",
          "source_updated_at",
          "policy_id",
          "claims",
          "evidence_fields",
          "confidence",
          "rights_status",
          "rights_basis",
          "attribution",
          "notes"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string" },
          "retrieved_at": {
            "anyOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "format": "date-time" }
            ]
          },
          "published_at": {
            "anyOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "format": "date-time" },
              { "const": "" }
            ]
          },
          "source_updated_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "string", "format": "date" },
              { "const": "" }
            ]
          },
          "policy_id": {
            "enum": [
              "legacy_forum_v1",
              "osm_odbl_discovery_v1",
              "google_places_restricted_v1",
              "project_field_observation_v1"
            ]
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "description": "Claim fields are unique per source; Python validation requires their fields to exactly match evidence_fields.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "value", "observed_at", "verification_method", "confidence"],
              "properties": {
                "field": { "type": "string" },
                "value": {},
                "observed_at": {
                  "anyOf": [
                    { "type": "string", "format": "date" },
                    { "type": "string", "format": "date-time" },
                    { "const": "" }
                  ]
                },
                "verification_method": {
                  "enum": ["source_report", "dataset_snapshot", "provider_api", "on_site_checklist"]
                },
                "confidence": { "enum": ["high", "medium", "low", "unknown"] }
              }
            }
          },
          "evidence_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "canonical_name",
                "branch_name",
                "branch_identity_status",
                "city",
                "district",
                "address",
                "coordinates",
                "operational_status",
                "contact.website_url",
                "contact.instagram_url",
                "contact.facebook_url",
                "contact.threads_url",
                "contact.google_maps_url",
                "contact.phone",
                "work_attributes.unlimited_time",
                "work_attributes.outlets",
                "work_attributes.wifi",
                "work_attributes.quietness",
                "work_attributes.seat_comfort",
                "work_attributes.meeting_suitability",
                "work_attributes.solo_work_suitability",
                "work_attributes.study_suitability",
                "work_attributes.online_meeting_suitability",
                "work_attributes.long_stay_suitability",
                "work_attributes.opening_hours",
                "work_attributes.minimum_order",
                "work_attributes.price_level",
                "work_attributes.food_available",
                "work_attributes.reservation"
              ]
            }
          },
          "confidence": { "enum": ["high", "medium", "low", "unknown"] },
          "rights_status": { "enum": ["cleared", "attribution_required", "restricted", "unknown"] },
          "rights_basis": { "type": "string" },
          "attribution": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "field_confidence": {
      "type": "object",
      "description": "Keys must exactly equal the union of structured claim fields.",
      "propertyNames": {
        "enum": [
          "canonical_name",
          "branch_name",
          "branch_identity_status",
          "city",
          "district",
          "address",
          "coordinates",
          "operational_status",
          "contact.website_url",
          "contact.instagram_url",
          "contact.facebook_url",
          "contact.threads_url",
          "contact.google_maps_url",
          "contact.phone",
          "work_attributes.unlimited_time",
          "work_attributes.outlets",
          "work_attributes.wifi",
          "work_attributes.quietness",
          "work_attributes.seat_comfort",
          "work_attributes.meeting_suitability",
          "work_attributes.solo_work_suitability",
          "work_attributes.study_suitability",
          "work_attributes.online_meeting_suitability",
          "work_attributes.long_stay_suitability",
          "work_attributes.opening_hours",
          "work_attributes.minimum_order",
          "work_attributes.price_level",
          "work_attributes.food_available",
          "work_attributes.reservation"
        ]
      },
      "additionalProperties": { "enum": ["high", "medium", "low", "unknown"] }
    },
    "overall_confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "last_verified_at": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" },
        { "const": "" }
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "field", "status", "summary", "signals"],
        "properties": {
          "conflict_id": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "status": { "enum": ["unresolved", "resolved"] },
          "summary": { "type": "string", "minLength": 1 },
          "signals": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "url", "retrieved_at", "reported_value", "notes"],
              "properties": {
                "source_type": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                "retrieved_at": {
                  "anyOf": [
                    { "type": "string", "format": "date" },
                    { "type": "string", "format": "date-time" }
                  ]
                },
                "reported_value": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
